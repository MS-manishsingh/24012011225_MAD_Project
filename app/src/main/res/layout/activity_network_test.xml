<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtNetworkTestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network Test"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtNetworkTestSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test your complete network performance"
            android:textSize="14sp"
            android:textColor="#A5B4FC"
            android:gravity="center"
            android:layout_marginBottom="35dp" />

        <TextView
            android:id="@+id/txtNetworkDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download: Waiting..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/txtNetworkUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload: Waiting..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4ADE80"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/txtNetworkPing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ping: Waiting..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FBBF24"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <ProgressBar
            android:id="@+id/progressNetworkTest"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="25dp" />

        <TextView
            android:id="@+id/txtNetworkTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to test network"
            android:textSize="16sp"
            android:textColor="#CBD5E1"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnStartNetworkTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Network Test"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />

        <Button
            android:id="@+id/btnNetworkTestBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>